# Copy to .env and fill in to switch from mock mode to a real Azure deployment.
# With all of these blank, everything runs offline in deterministic mock mode.

# Azure OpenAI (the target bot and/or the LLM judge)
#
# Two endpoint styles are supported automatically:
#  1. Classic Azure OpenAI:  https://<resource>.openai.azure.com
#  2. Microsoft Foundry v1:   https://<resource>.services.ai.azure.com/openai/v1
#     (detected automatically; uses the OpenAI client with base_url)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Auth mode: "key" (default, uses AZURE_OPENAI_API_KEY) or "entra" (Microsoft
# Entra ID token via DefaultAzureCredential — needs `pip install azure-identity`
# and `az login`, and the API key may be left blank).
AZURE_AUTH_MODE=key

# APIM / custom gateway (e.g. the Nexus AI hackathon gateway): set this to the
# custom auth header name and the key goes in THAT header instead of Authorization.
# Leave blank for a normal Azure OpenAI / Foundry endpoint. Example gateway setup:
#   AZURE_OPENAI_ENDPOINT=https://<host>/aix-openai-api/v1/models
#   AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
#   AZURE_OPENAI_API_VERSION=2025-04-01-preview
#   AUDITOR_GATEWAY_AUTH_HEADER=mtb-client_id
#   MTB_CLIENT_ID=<your team key>
AUDITOR_GATEWAY_AUTH_HEADER=

# Claude endpoint on the same gateway — used by `app.cli preflight` to ping the
# Anthropic models before a demo. Leave blank to skip the Claude check.
#   ANTHROPIC_GATEWAY_ENDPOINT=https://<host>/aix-anthropic-api/v1/anthropic
#   ANTHROPIC_MODEL=claude-sonnet-5
#   ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_GATEWAY_ENDPOINT=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VERSION=2023-06-01

# Azure AI Content Safety — Prompt Shields (used by the prompt_shield guardrail)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Feature flags (keep values on their own line — no inline comments)
# true = attack a real Azure OpenAI deployment
AUDITOR_USE_LLM_TARGET=false
# true = use the LLM judge for hallucination checks
AUDITOR_USE_LLM_JUDGE=false

# Release gate threshold (max allowed weighted risk score)
AUDITOR_GATE_MAX_RISK=10

# Observability — print every prompt/request+response sent to Azure OpenAI and
# Azure AI Content Safety to the console. Optional log file to also append them.
AUDITOR_DEBUG_LLM=false
# AUDITOR_LLM_LOG=llm_trace.log

# Logging level for all modules: DEBUG, INFO (default), WARNING, ERROR.
# DEBUG shows per-attack verdicts and guardrail triggers; INFO shows milestones.
# (CLI also accepts --log-level, e.g. `python -m app.cli audit --log-level DEBUG`.)
AUDITOR_LOG_LEVEL=INFO
